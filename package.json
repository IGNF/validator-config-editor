{
  "name": "validator-config-editor",
  "version": "0.0.0",
  "description": "Validation et édition des configurations IGNF/validator (CLI vce)",
  "license": "AGPL-3.0-or-later",
  "repository": "github:IGNF/validator-config-editor",
  "type": "module",
  "bin": {
    "vce": "bin/vce.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:ui && npm run build:cli",
    "build:ui": "vite build",
    "build:cli": "vite build --config vite.cli.config.ts",
    "schemas": "tsx scripts/compile-schemas.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@mdi/js": "7.4.47",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "eslint": "10.11.0",
    "pinia": "4.0.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11",
    "vuetify": "4.2.3"
  }
}
